pipeline {
    agent { label "agent-1" }

    options {
        skipDefaultCheckout(false)
        disableConcurrentBuilds()
    }

    environment {
        FRONT_DIR    = "Code/front-end"
        BACK_DIR     = "Code/back-end"
        FRONT_IMAGE  = "997206200726.dkr.ecr.eu-north-1.amazonaws.com/gp-front"
        BACK_IMAGE   = "997206200726.dkr.ecr.eu-north-1.amazonaws.com/gp-back"

        // ECR-specific settings. ECR_REGISTRY is the host portion of
        // FRONT_IMAGE/BACK_IMAGE - used for `docker login`.
        AWS_REGION   = "eu-north-1"
        ECR_REGISTRY = "997206200726.dkr.ecr.eu-north-1.amazonaws.com"

        DEV_VALUES   = "Helm/devops-app/dev-values.yml"
        TEST_VALUES  = "Helm/devops-app/test-values.yml"
        PROD_VALUES  = "Helm/devops-app/prod-values.yml"

        GIT_REPO_URL = "https://github.com/cloudpd/Intelligent_Infrastructure_Automation_Platform.git"
    }

    stages {

        // ---------- Compute an immutable tag once, reuse it in every later stage ----------
        // Only meaningful on 'dev' (that's the only branch that actually builds).
        // On test/main we don't rebuild - we just carry forward the tag that was
        // already built & pushed on dev, so FRONT_CHANGED/BACK_CHANGED here only
        // drive the dev build decision.
        stage('Prepare') {
            steps {
                script {
                    env.SHORT_SHA  = sh(script: "git rev-parse --short=8 HEAD", returnStdout: true).trim()
                    env.IMAGE_TAG  = "${env.BRANCH_NAME}-${env.SHORT_SHA}"
                    env.FRONT_CHANGED = sh(script: "git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q '^${FRONT_DIR}/' && echo true || echo false", returnStdout: true).trim()
                    env.BACK_CHANGED  = sh(script: "git diff --name-only HEAD~1 HEAD 2>/dev/null | grep -q '^${BACK_DIR}/'  && echo true || echo false", returnStdout: true).trim()
                    echo "IMAGE_TAG=${env.IMAGE_TAG}  FRONT_CHANGED=${env.FRONT_CHANGED}  BACK_CHANGED=${env.BACK_CHANGED}"
                }
            }
        }

        // =====================================================================
        // CI — runs only on PRs into dev. dev is the only branch where source
        // code actually changes; test/main only ever receive promotion commits
        // (values.yml bumps), so there's nothing new to lint/test there.
        // =====================================================================

        stage('Lint & Unit Test - Front') {
            when {
                changeRequest target: 'dev'
                changeset "${FRONT_DIR}/**"
            }

            agent {
                docker {
                    image "node:18-alpine"
                    label "agent-1"
                }
            }

            steps {
                dir("${FRONT_DIR}") { // install dependencies
                    sh 'npm ci'
                    sh 'CI=true npm test -- --watchAll=false || true '
                }
            }
        }

        stage('Lint & Unit Test - Back') {
            when {
                changeRequest target: 'dev'
                changeset "${BACK_DIR}/**"
            }

            agent {
                docker {
                    image "node:18-alpine"
                    label "agent-1"
                }
            }

            steps {
                dir("${BACK_DIR}") {
                    sh 'npm ci'
                    // TODO: replace with a real test suite - package.json currently has a stub 'test' script
                    sh 'node -e "require(\'./src/server.js\')" || echo "smoke-require skipped"'
                }
            }
        }

        stage('Trivy FS + Config Scan') {
            when {
                changeRequest target: 'dev'
            }
            agent {
                docker {
                    image 'aquasec/trivy:latest'
                    args '--entrypoint=""'
                    label "agent-1"
                }
            }
            environment { HOME = "${WORKSPACE}" }

            steps {
                script {
                    if (env.CHANGE_TARGET) {
                        sh "trivy fs --cache-dir ${WORKSPACE}/.trivy-cache --format table ."
                        sh "trivy config --cache-dir ${WORKSPACE}/.trivy-cache --format table ${FRONT_DIR}/Dockerfile"
                        sh "trivy config --cache-dir ${WORKSPACE}/.trivy-cache --format table ${BACK_DIR}/Dockerfile"
                    }
                }
            }
        }

        // =====================================================================
        // CD - dev: the ONLY place images get built. Real merge/push to dev
        // (not a PR). Build once here, scan, push, and everything downstream
        // (test, prod) just promotes this exact tag.
        //
        // ECR auth: unlike Docker Hub, ECR doesn't take a static
        // username/password. We fetch a short-lived token via the AWS CLI
        // and feed it to `docker login`. Requires:
        //   1) two Jenkins credentials of type "Secret text":
        //      AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, from an IAM
        //      user with ecr:GetAuthorizationToken,
        //      ecr:BatchCheckLayerAvailability, ecr:InitiateLayerUpload,
        //      ecr:UploadLayerPart, ecr:CompleteLayerUpload, ecr:PutImage
        //      on the gp-front / gp-back repos. Note: this only works with
        //      a long-lived IAM user's keys, not temporary/STS credentials
        //      (no session token is passed through).
        //   2) the `aws` CLI installed on agent-1.
        //   3) the ECR repos (gp-front, gp-back) must already exist -
        //      unlike Docker Hub, ECR does not auto-create them on push.
        //
        // Alternative (often simpler if agent-1 runs on EC2): attach an IAM
        // instance role with the same permissions to the agent instead, and
        // drop the withCredentials block entirely - `aws ecr get-login-password`
        // will use the instance role automatically.
        // =====================================================================

        stage('Build, Scan & Push - Front [dev]') {
            when { allOf { branch 'dev'; not { changeRequest() }; expression { env.FRONT_CHANGED == 'true' } } }
            agent { label "agent-1" }
            steps {
                dir("${FRONT_DIR}") { sh "docker build -t ${FRONT_IMAGE}:${IMAGE_TAG} ." }
                sh """
                    mkdir -p ${WORKSPACE}/.trivy-cache
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                        -v ${WORKSPACE}/.trivy-cache:/tmp/.cache -e HOME=/tmp -e XDG_CACHE_HOME=/tmp/.cache \
                        aquasec/trivy:latest image --exit-code 1 --severity CRITICAL --format table ${FRONT_IMAGE}:${IMAGE_TAG}
                """
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${FRONT_IMAGE}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Build, Scan & Push - Back [dev]') {
            when { allOf { branch 'dev'; not { changeRequest() }; expression { env.BACK_CHANGED == 'true' } } }
            agent { label "agent-1" }
            steps {
                dir("${BACK_DIR}") { sh "docker build -t ${BACK_IMAGE}:${IMAGE_TAG} ." }
                sh """
                    mkdir -p ${WORKSPACE}/.trivy-cache
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
                      -v ${WORKSPACE}/.trivy-cache:/tmp/.cache -e HOME=/tmp -e XDG_CACHE_HOME=/tmp/.cache \
                      aquasec/trivy:latest image --exit-code 1 --severity CRITICAL --format table ${BACK_IMAGE}:${IMAGE_TAG}|| true
                """
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY_ID', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_SECRET_ACCESS_KEY', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${BACK_IMAGE}:${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Promote tag -> dev-values.yml') {
            when { allOf { branch 'dev'; not { changeRequest() } } }
            agent { label "agent-1" }
            steps {
                gitOpsBumpTag(env.DEV_VALUES)
            }
        }

        // =====================================================================
        // CD - test/staging: NO build here. We promote the exact tag(s) that
        // were built & validated on dev straight into test-values.yml, then
        // run (simulated) DAST against the freshly-deployed test environment.
        // =====================================================================

        stage('Promote tag -> test-values.yml') {
            when { allOf { branch 'test'; not { changeRequest() } } }
            agent { label "agent-1" }
            steps {
                gitOpsPromoteTag(env.DEV_VALUES, env.TEST_VALUES, 'test')
                echo "test-values.yml updated. ArgoCD (auto-sync on test) will pick this up and deploy."
            }
        }

        // NOTE: these are SIMULATED DAST stages - there's no real ZAP/Nikto/Nuclei
        // scanner wired in yet. They exist as placeholders so the pipeline shape
        // is correct; swap the echo/sleep blocks for a real `docker run owasp/zap2docker-stable
        // zap-baseline.py -t $TEST_APP_URL` (or similar) once you have real DAST tooling.
        stage('Simulate DAST Scan - Front [test]') {
            when { allOf { branch 'test'; not { changeRequest() } } }
            agent { label "agent-1" }
            steps {
                sh '''
                    echo "==================================================="
                    echo " DAST Simulation Report - Front-end [test]"
                    echo "==================================================="
                    sleep 3
                    echo "[INFO] Spidering target ..."
                    sleep 2
                    echo "[INFO] Passive scan rules executed: 42"
                    echo "[INFO] Active scan rules executed: 15"
                    echo "[PASS] No High risk alerts found (simulated)"
                    echo "[WARN] 2 Medium risk alerts found (simulated) - missing security headers"
                    echo "==================================================="
                '''
            }
        }

        stage('Simulate DAST Scan - Back [test]') {
            when { allOf { branch 'test'; not { changeRequest() } } }
            agent { label "agent-1" }
            steps {
                sh '''
                    echo "==================================================="
                    echo " DAST Simulation Report - Back-end API [test]"
                    echo "==================================================="
                    sleep 3
                    echo "[INFO] Enumerating API endpoints ..."
                    sleep 2
                    echo "[INFO] Auth/session checks executed: 8"
                    echo "[INFO] Injection checks executed: 20"
                    echo "[PASS] No High/Critical risk alerts found (simulated)"
                    echo "[WARN] 1 Low risk alert found (simulated) - verbose error messages"
                    echo "==================================================="
                '''
            }
        }

        // =====================================================================
        // CD - prod: merge to main. NO build, NO scan - promote the exact
        // tag(s) that were validated on test, but only after a human approves.
        // Just a straight tag copy - same style as dev/test, no canary.
        // ArgoCD prod app is manual-sync, so this stage only prepares the
        // commit; a human still clicks Sync in the ArgoCD UI afterwards.
        // =====================================================================

        stage('Approval - Deploy to Production') {
            when { allOf { branch 'main'; not { changeRequest() } } }
            agent none
            steps {
                script {
                    def decision = input(
                        id: 'prodApproval',
                        message: 'Promote the tested image tag(s) from test-values.yml to PRODUCTION?',
                        parameters: [choice(name: 'ACTION', choices: ['Approve', 'Abort'], description: 'Approve to proceed, Abort to stop the pipeline here')]
                    )
                    if (decision == 'Abort') {
                        error("Production promotion aborted by approver.")
                    }
                }
            }
        }

        stage('Promote tag -> prod-values.yml') {
            when { allOf { branch 'main'; not { changeRequest() } } }
            agent { label "agent-1" }
            steps {
                gitOpsPromoteTag(env.TEST_VALUES, env.PROD_VALUES, 'main')
                echo "prod-values.yml updated with new image tag(s). Go to ArgoCD UI -> devops-app (prod) -> click Sync to apply."
            }
        }

    }

    post {
        always {
            sh 'docker image prune -af || true'
        }
    }
}

// ---------------------------------------------------------------------------
// Shared step (dev only): bump the image tag(s) that were JUST built in this
// run into the given values file. Conditional on FRONT_CHANGED/BACK_CHANGED
// and always writes env.IMAGE_TAG. Pushes back to whatever branch triggered
// the build (env.BRANCH_NAME).
// ---------------------------------------------------------------------------
def gitOpsBumpTag(String valuesFile) {
    if (env.FRONT_CHANGED == 'true') {
        sh """
            docker run --rm -v \${WORKSPACE}:/w -w /w mikefarah/yq:latest \
              -i '.front-chart.image.tag = "${env.IMAGE_TAG}"' ${valuesFile}
        """
    }
    if (env.BACK_CHANGED == 'true') {
        sh """
            docker run --rm -v \${WORKSPACE}:/w -w /w mikefarah/yq:latest \
              -i '.back-chart.image.tag = "${env.IMAGE_TAG}"' ${valuesFile}
        """
    }
    withCredentials([usernamePassword(credentialsId: 'GIT_REPO_CREDENTIALS', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
        sh """
            git config user.email "jenkins-ci@pipeline"
            git config user.name "jenkins-ci"
            git add ${valuesFile}
            git commit -m "build ${env.IMAGE_TAG} -> ${valuesFile} [ci skip]" || echo "nothing to commit"
            git push https://\$GIT_USER:\$GIT_TOKEN@github.com/cloudpd/Intelligent_Infrastructure_Automation_Platform.git HEAD:${env.BRANCH_NAME}
        """
    }
}

// ---------------------------------------------------------------------------
// Shared step (test & prod): promote whatever tag(s) already exist in
// sourceFile straight into targetFile - no build, no env.IMAGE_TAG involved.
// Used by dev->test and test->prod. Unconditional (always copies both
// front/back tags), since the source file already reflects only what was
// actually built and validated upstream.
// ---------------------------------------------------------------------------
def gitOpsPromoteTag(String sourceFile, String targetFile, String targetBranch) {
    sh """
        docker run --rm -v \${WORKSPACE}:/w -w /w --entrypoint sh mikefarah/yq:latest -c '
            FRONT_TAG=\$(yq ".front-chart.image.tag" ${sourceFile})
            BACK_TAG=\$(yq ".back-chart.image.tag" ${sourceFile})
            yq -i ".front-chart.image.tag = \\"\$FRONT_TAG\\"" ${targetFile}
            yq -i ".back-chart.image.tag = \\"\$BACK_TAG\\"" ${targetFile}
        '
    """
    withCredentials([usernamePassword(credentialsId: 'GIT_REPO_CREDENTIALS', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
        sh """
            git config user.email "jenkins-ci@pipeline"
            git config user.name "jenkins-ci"
            git add ${targetFile}
            git commit -m "promote tag(s) from ${sourceFile} -> ${targetFile} [ci skip]" || echo "nothing to commit"
            git pull --rebase https://\$GIT_USER:\$GIT_TOKEN@github.com/cloudpd/Intelligent_Infrastructure_Automation_Platform.git ${targetBranch}
            git push https://\$GIT_USER:\$GIT_TOKEN@github.com/cloudpd/Intelligent_Infrastructure_Automation_Platform.git HEAD:${targetBranch}
        """
    }
}